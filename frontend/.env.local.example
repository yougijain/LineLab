# Base URL of the LineLab Solver FastAPI backend.
# Local dev default is http://localhost:8000. Set this in Vercel / your host to
# point at your deployed backend (Render / Fly / Railway).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase — LineLab project (ref: gsfrghcurkixqmrqghaw).
# The publishable (anon) key is safe to expose in the browser; RLS protects writes.
NEXT_PUBLIC_SUPABASE_URL=https://gsfrghcurkixqmrqghaw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
