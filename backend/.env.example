# LineLab backend configuration.
#
# Every variable here is OPTIONAL — the API runs with an empty .env. It falls
# back to the local JSON scenario store and leaves the chat-coach off.
# `GET /api/health` reports which stores and features are actually active.
#
# Copy to .env and fill in what you need. Never commit real values.

# --- API access -------------------------------------------------------------

# Comma-separated exact origins allowed to call the API from a browser.
LINELAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for additional allowed origins, e.g. generated preview
# hostnames. Left unset, only the exact origins above are allowed.
LINELAB_CORS_ORIGIN_REGEX=

# --- Scenario store ---------------------------------------------------------

# Where the JSON fallback store keeps saved scenarios. Defaults to backend/data.
# Point this at a writable path on hosts that mount the app directory read-only
# (the Vercel deployment sets it to /tmp/linelab).
LINELAB_DATA_DIR=

# Postgres connection string for the Supabase scenario store. Setting this
# switches the API off the JSON fallback and onto real persistence.
#
# Get it from the Supabase dashboard: your project -> Connect -> Session pooler
# (port 5432), then substitute your database password for [YOUR-PASSWORD]. The
# session pooler is the right choice for a long-lived FastAPI process; the
# transaction pooler (6543) also works, since db.py disables prepared statements.
#
# This string CONTAINS YOUR DATABASE PASSWORD. Set it as a host environment
# variable in production — never in vercel.json or any committed file.
SUPABASE_DB_URL=

# --- Optional AI chat-coach -------------------------------------------------

# Enables the streaming chat-coach at POST /api/coach/chat. Off when unset.
ANTHROPIC_API_KEY=
